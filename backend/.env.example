# Database connection:
# 1. PostgreSQL (recommended for team submission):
# DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/app_db
# 2. SQLite (default for instant zero-setup local running and testing):
DATABASE_URL=sqlite:///./app.db

# CHANGE THIS in any real project. Min 32 characters.
JWT_SECRET=change-me-this-is-a-demo-secret-key-please-replace-32+chars
JWT_EXPIRATION_MINUTES=1440

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
